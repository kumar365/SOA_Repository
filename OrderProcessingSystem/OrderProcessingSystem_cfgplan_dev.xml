		<replace>8889</replace>
	<searchReplace>-->
      <import>
         <searchReplace>
            <search/>
            <replace/>
         </searchReplace>
      </import>
      <service name="ops_bpel_client_ep">
         <binding type="ws">
            <attribute name="port">
               <replace>http://xmlns.oracle.com/SOAApplication/OrderProcessingSystem/OPS_BPEL#wsdl.endpoint(ops_bpel_client_ep/OPS_BPEL_pt)</replace>
            </attribute>
         </binding>
         <callback>
            <binding type="ws">
               <attribute name="port">
                  <replace>http://xmlns.oracle.com/SOAApplication/OrderProcessingSystem/OPS_BPEL#wsdl.endpoint(ops_bpel_client_ep/OPS_BPELCallback_pt)</replace>
               </attribute>
            </binding>
         </callback>
      </service>
      <property name="productVersion">
         <replace>14.1.2.0.0</replace>
      </property>
      <property name="compositeID">
         <replace>5f64e5a2-de1d-4b8e-bf79-b99e03171f9e</replace>
      </property>
      <!--Add search and replace rules for the component properties
	For components and service/reference bindings, you can add policy references.
	Example:
	<component name="*">
		<wsp:PolicyReference orawsp:category="management" orawsp:status="enabled" URI="oracle/log_policy"/>
	</component>-->
      <component name="OPS_BPEL">
         <property name="bpel.config.oneWayDeliveryPolicy">
            <replace>async.persist</replace>
         </property>
      </component>
      <reference name="CVSReference">
         <!--Add search and replace rules for the binding properties-->
         <binding type="ws">
            <attribute name="port">
               <replace>http://xmlns.oracle.com/SOAApplication/CardValidationSystem/CVSBPELProcess#wsdl.endpoint(cvsbpelprocess_client_ep/CVSBPELProcess_pt)</replace>
            </attribute>
            <attribute name="location">
               <replace>http://localhost:7101/soa-infra/services/default/CardValidationSystem/cvsbpelprocess_client_ep?WSDL</replace>
            </attribute>
            <property name="weblogic.wsee.wsat.transaction.flowOption">
               <replace>WSDLDriven</replace>
            </property>
         </binding>
      </reference>
      <reference name="BMSReference">
         <!--Add search and replace rules for the binding properties-->
         <binding type="ws">
            <attribute name="port">
               <replace>http://practice.com/SOAApplication/BillingManagementSystem/BMS_BPELProcess#wsdl.endpoint(bms_bpelprocess_client_ep/BMS_BPELProcess_pt)</replace>
            </attribute>
            <attribute name="location">
               <replace>http://localhost:7101/soa-infra/services/default/BillingManagementSystem/bms_bpelprocess_client_ep?WSDL</replace>
            </attribute>
            <property name="weblogic.wsee.wsat.transaction.flowOption">
               <replace>WSDLDriven</replace>
            </property>
         </binding>
         <callback>
            <binding type="ws">
               <attribute name="port">
                  <replace>http://practice.com/SOAApplication/BillingManagementSystem/BMS_BPELProcess#wsdl.endpoint(bms_bpelprocess_client_ep/BMS_BPELProcessCallback_pt)</replace>
               </attribute>
            </binding>
         </callback>
      </reference>
