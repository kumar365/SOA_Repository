<?xml version = "1.0" encoding = "UTF-8" ?>
<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer

  Created: Tue Sep 15 11:29:15 IST 2026
  Author:  kumar
  Type: BPEL 2.0 Process
  Purpose: Empty BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="HellowordBPEL"
               targetNamespace="http://xmlns.oracle.com/SOAApplication/HelloWord/HellowordBPEL"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/SOAApplication/HelloWord/HellowordBPEL"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
               xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http:/practice.com/demo1/hellowordInterface" xmlns:ns2="http://practice.com/demo1/request"
         xmlns:ns3="http://practice.com/demo1/response" xmlns:ui="http://xmlns.oracle.com/soa/designer"
         xmlns:oraext="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.ExtFunc"
         xmlns:bpm="http://xmlns.oracle.com/bpmn20/extensions"
         xmlns:xp20="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.Xpath20"
         xmlns:ess="http://xmlns.oracle.com/scheduler" xmlns:hwf="http://xmlns.oracle.com/bpel/workflow/xpath"
         xmlns:xref="http://www.oracle.com/XSL/Transform/java/oracle.tip.xref.xpath.XRefXPathFunctions"
         xmlns:dvm="http://www.oracle.com/XSL/Transform/java/oracle.tip.dvm.LookupValue"
         xmlns:bpws="http://schemas.xmlsoap.org/ws/2003/03/business-process/"
         xmlns:xdk="http://schemas.oracle.com/bpel/extension/xpath/function/xdk"
         xmlns:ids="http://xmlns.oracle.com/bpel/services/IdentityService/xpath"
         xmlns:ldap="http://schemas.oracle.com/xpath/extension/ldap">

  <!--
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC
     Set of activities coordinating the flow of messages across the
     services integrated within this business process
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <import namespace="http:/practice.com/demo1/hellowordInterface" location="../WSDLs/hellowordInterfaceWrapper.wsdl"
          importType="http://schemas.xmlsoap.org/wsdl/" ui:processWSDL="true"/>
  <partnerLinks>
    <partnerLink name="HellowordService" partnerLinkType="ns1:HellowordService" myRole="hellowordPort"/>
  </partnerLinks>
  <variables>
    <variable name="HellowordInputVariable" messageType="ns1:requestMessage"/>
    <variable name="HellowordOutputVariable" messageType="ns1:replyMessage"/>
  </variables>
  <sequence name="main">
    <receive name="HellowordReceive" createInstance="yes" partnerLink="HellowordService" portType="ns1:hellowordPort"
             operation="hellowordOperation" variable="HellowordInputVariable"/>
    <assign name="Assign1">
      <copy>
        <from>concat("Hi"," ",$HellowordInputVariable.part1/ns2:username)</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$HellowordOutputVariable.part1/ns3:wish</to>
      </copy>
    </assign>
    <reply name="HellowordReply" partnerLink="HellowordService" variable="HellowordOutputVariable"
           portType="ns1:hellowordPort" operation="hellowordOperation"/>
  </sequence>
</process>