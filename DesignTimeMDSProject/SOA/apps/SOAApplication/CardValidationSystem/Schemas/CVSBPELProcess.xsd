<?xml version="1.0" encoding="UTF-8"?>
<schema attributeFormDefault="unqualified" elementFormDefault="qualified"
        targetNamespace="http://xmlns.oracle.com/SOAApplication/CardValidationSystem/CVSBPELProcess"
        xmlns="http://www.w3.org/2001/XMLSchema">
  <element name="cardReq">
    <complexType>
      <sequence>
        <element name="ccNumber" type="integer"/>
        <element name="ccVender" type="string"/>
      </sequence>
    </complexType>
  </element>
  <element name="cardRes">
    <complexType>
      <sequence>
        <element name="ccNumber" type="integer"/>
        <element name="ccVender" type="string"/>
        <element name="ccStatus" type="string"/>
      </sequence>
    </complexType>
  </element>
  <element name="faultSchema">
    <complexType>
      <sequence>
        <element name="code" type="integer"/>
        <element name="faultName" type="string"/>
        <element name="faultMessage" type="string"/>
      </sequence>
    </complexType>
  </element>
</schema>