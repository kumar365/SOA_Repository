<?xml version= '1.0' encoding= 'UTF-8' ?>
<wsdl:definitions
     name="OrderRestService"
     targetNamespace="http://xmlns.oracle.com/SOAApplication/OrderRestService/OrderRestService"
     xmlns:tns="http://xmlns.oracle.com/SOAApplication/OrderRestService/OrderRestService"
     xmlns:inp1="http://practice.com/order/create/request"
     xmlns:inp2="http://practice.com/order/response"
     xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype"
     xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    >
    <plnk:partnerLinkType name="OrderRestService">
        <plnk:role name="OrderRestServiceProvider" portType="tns:OrderRestService_ptt"/>
    </plnk:partnerLinkType>
    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://practice.com/order/create/request" schemaLocation="../Schemas/orderRequest.xsd"/>
        </xsd:schema>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://practice.com/order/response" schemaLocation="../Schemas/orderResponse.xsd"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="CreateOperation_inputMessage">
        <wsdl:part name="request" element="inp1:OrderCreateRequest"/>
    </wsdl:message>
    <wsdl:message name="CreateOperation_outputMessage">
        <wsdl:part name="reply" element="inp2:OrderResponse"/>
    </wsdl:message>
    <wsdl:portType name="OrderRestService_ptt">
        <wsdl:operation name="CreateOperation">
            <wsdl:input message="tns:CreateOperation_inputMessage"/>
            <wsdl:output message="tns:CreateOperation_outputMessage"/>
        </wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
